# =============================================================================
#  Beispielkonfiguration
#
#  Diese Datei enthaelt KEINE Geheimnisse und wird versioniert.
#  Zum Arbeiten:  cp .env.example .env
#
#  Die Werte unten passen zur lokalen Docker-Compose-Umgebung
#  (infra/compose/docker-compose.yml). Sie sind bewusst oeffentlich bekannt und
#  duerfen in keiner erreichbaren Umgebung verwendet werden.
#
#  Produktive Werte kommen ausschliesslich aus Umgebungsvariablen oder einem
#  Secret Store. Die Anwendung startet nicht mit unsicheren Vorgabewerten
#  (docs/architecture/security-model.md Abschnitt 8).
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# --- API und Web ---
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Datenhaltung ---
DATABASE_URL=postgresql://crm:crm-local-development@localhost:5432/crm?schema=public
REDIS_URL=redis://localhost:6379

# --- Object Storage (MinIO) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=eu-central-1
STORAGE_BUCKET=crm-documents
STORAGE_ACCESS_KEY_ID=crm-local-access-key
STORAGE_SECRET_ACCESS_KEY=crm-local-secret-key
STORAGE_FORCE_PATH_STYLE=true
# Gueltigkeit signierter Downloadlinks in Sekunden (30..900)
STORAGE_SIGNED_URL_TTL_SECONDS=300

# --- Identitaet (Keycloak) ---
OIDC_ISSUER_URL=http://localhost:8080/realms/crm
OIDC_CLIENT_ID=crm-api
OIDC_CLIENT_SECRET=lokales-entwicklungsgeheimnis-crm-api
OIDC_AUDIENCE=crm-api

# --- Magic Link fuer Datenergaenzung ---
# Mindestens 32 Zeichen. Fuer eigene Umgebungen neu erzeugen:
#   openssl rand -base64 48
MAGIC_LINK_SECRET=ersetzen-durch-eigenen-wert-mit-mindestens-32-zeichen
MAGIC_LINK_TTL_MINUTES=30

# --- E-Mail (Mailpit) ---
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@beispiel.invalid
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

# --- Malware-Scan (ClamAV) ---
# "noop" ist ausschliesslich fuer Entwicklung und Test zulaessig.
MALWARE_SCANNER=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Adapter ---
# "real" ist nicht freigegeben: docs/callidus/capability-matrix.md Abschnitt 5.
CALLIDUS_ADAPTER=mock
SIGNATURE_PROVIDER=mock
SIGNATURE_WEBHOOK_SECRET=ersetzen-durch-eigenen-wert-mit-mindestens-32-zeichen

# --- Uploads ---
UPLOAD_MAX_BYTES=20971520
