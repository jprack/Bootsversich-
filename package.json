{
  "name": "versicherungs-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "db:migrate": "pnpm --filter @app/api exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @app/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @app/api exec prisma generate",
    "db:seed": "pnpm --filter @app/api run db:seed",
    "db:reset": "pnpm --filter @app/api exec prisma migrate reset --force",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/compose/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "prisma",
      "@prisma/engines",
      "sharp",
      "unrs-resolver",
      "@nestjs/core"
    ]
  }
}
